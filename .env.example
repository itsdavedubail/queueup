# Copy to .env for running the API outside Docker.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://queueup:queueup@localhost:5432/queueup
REDIS_URL=redis://localhost:6379/0
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-before-deploying-0000
ACCESS_TOKEN_EXPIRE_MINUTES=30
